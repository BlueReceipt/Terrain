// How Cloudflare publishes the demo's relay (README, "The demo's relay"): the Worker `terrain-mymaps`
// on two routes of the demo's address. Connected to the GitHub repository with `relay` as its root
// directory, each push to main runs `npx wrangler deploy` here. Your own copy: change the name to your
// Worker's and the routes to your demo address and its domain.
{
  "name": "terrain-mymaps",
  "main": "worker.js",
  "compatibility_date": "2026-10-05",
  // Wrangler replaces the Worker's routes with these on each deploy, so all of them stay listed.
  "routes": [
    { "pattern": "terrain.ederer.digital/mymaps*", "zone_name": "ederer.digital" },
    { "pattern": "terrain.ederer.digital/tiles/*", "zone_name": "ederer.digital" },
  ],
  "workers_dev": false,
  "preview_urls": false,
}
